#!/bin/sh
# pre-push: fast gate before the branch leaves this machine.
#
# Install once with: git config core.hooksPath .githooks
# Bypass (logged, not silent): PB_SKIP_PUSH_HOOK=1 git push
set -e

if [ "${PB_SKIP_PUSH_HOOK:-0}" = "1" ]; then
  mkdir -p .git
  printf '%s BYPASS %s remote=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(git rev-parse --short HEAD)" "${1:-unknown}" >> .git/hook-bypass.log
  echo "[pre-push] bypassed by PB_SKIP_PUSH_HOOK=1 (logged to .git/hook-bypass.log)"
  exit 0
fi

echo "[pre-push] npm run test:fast"
npm run test:fast
